rules_version = '2';

// Security rules for the Team Dashboard Firestore database.
//
// This file is a checked-in copy of what is deployed in the Firebase console
// (Firestore → Rules). Nothing in this repo deploys it — there is no Firebase CLI
// setup here and the app is a single static page — so if the rules are ever
// changed in the console, update this file to match. (Same pattern as the
// sprint-velocity and paptrack-ios repos.)
//
// Project: teamdashboard-6723f.
//
// Confirmed from outside on 2026-08-06 that the database exists and denies
// unauthenticated reads on both /teamdashboard/{uid} and every other path. Note
// what that does NOT prove: an unauthenticated probe cannot tell a correct
// per-user rule from a blanket deny-all, and a signed-in probe is the only thing
// that can. Re-verify the rule *text* in the console after any change.
service cloud.firestore {
  match /databases/{database}/documents {

    // Sync stores one document per signed-in user, holding
    // { data, updatedAt, serverAt, writerId }, where data is { teams, settings }.
    // serverAt is a server timestamp and is what decides which copy is newer —
    // two devices' own clocks can't be compared. writerId identifies the device
    // that wrote it, so a device can tell its own write from another's. No rule
    // change was needed for those fields: the owner may write anything here.
    //
    // The {uid} path segment is the user's Firebase auth UID, so comparing it to
    // request.auth.uid is what confines each account to its own record. A rule of
    // just `request.auth != null` would let any signed-in Google account read every
    // other user's teams, while refusing anonymous callers identically — so the
    // difference between the two is invisible from outside. Keep the comparison.
    match /teamdashboard/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default: there is deliberately no
    // `match /{document=**}` catch-all, and the app touches no other path.
  }
}
